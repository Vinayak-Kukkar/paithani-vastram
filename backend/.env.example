# ===================================================
# PAITHANI VASTRAM - Backend Environment Variables
# ===================================================

# Port to listen on (Render sets this automatically)
PORT=5000

# Node Environment: 'development' or 'production'
NODE_ENV=production

# MongoDB Connection String (Atlas URI or local MongoDB)
# Note for Render: Ensure MongoDB Atlas IP Whitelist has 0.0.0.0/0 enabled!
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/paithani_vastram?retryWrites=true&w=majority

# Allowed Frontend URL for CORS (your Vercel deployment URL)
# Note: All *.vercel.app preview URLs are also automatically allowed
CLIENT_URL=https://your-paithani-storefront.vercel.app
